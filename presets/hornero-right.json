{
  "_name": "Hornero Right",
  "_description": "Right sidebar — full featured, mirrored reference shell style — inspired by Caelestia's layout",
  "_icon": "🏠",
  "_glyph": "layout-sidebar-right",
  "bar": {
    "persistent": true,
    "showOnHover": true,
    "sizes": {
      "innerWidth": 44,
      "contentScale": 1.25,
      "islandInset": 6
    },
    "workspaces": {
      "activeInset": 4
    },
    "status": {
      "showAudio": true,
      "showMicrophone": true,
      "showNetwork": true,
      "showBluetooth": true,
      "showBattery": true
    },
    "scrollActions": {
      "workspaces": true,
      "volume": true,
      "brightness": true
    },
    "bars": [
      {
        "edge": "right",
        "style": "attached",
        "reserve": true,
        "margin": 6,
        "thickness": 60,
        "density": "values",
        "backdrop": "solid",
        "groups": {
          "start": [
            {
              "id": "logo",
              "enabled": true,
              "options": {}
            },
            {
              "id": "workspaces",
              "enabled": true,
              "options": {}
            }
          ],
          "center": [
            {
              "id": "activeWindow",
              "enabled": true,
              "options": {}
            }
          ],
          "end": [
            {
              "id": "clock",
              "enabled": true,
              "options": {}
            },
            {
              "id": "statusIcons",
              "enabled": true,
              "options": {}
            },
            {
              "id": "tray",
              "enabled": true,
              "options": {}
            },
            {
              "id": "extensions",
              "enabled": true
            },
            {
              "id": "power",
              "enabled": true,
              "options": {}
            }
          ]
        }
      }
    ]
  },
  "border": {
    "frameEnabled": true,
    "thickness": 6
  },
  "appearance": {
    "rounding": {
      "scale": 1.0
    },
    "padding": {
      "scale": 1.0
    },
    "spacing": {
      "scale": 1.0
    }
  },
  "_lineage": "Layout inspired by Caelestia (caelestia-shell); composition preserved with attribution, rendered in Hornero Signal"
}
