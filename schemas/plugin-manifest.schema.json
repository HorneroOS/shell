{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://horneroos.com/schemas/shell-plugin-manifest.json",
  "title": "Hornero Shell Plugin Manifest",
  "description": "Metadata contract for community-authored Hornero Shell extensions, schema version 3 (PluginKit 3, Hornero Signal). Versions 1 and 2 targeted the removed Material-era PluginKit and are rejected with a migration hint by scripts/validate_plugin.py and the runtime host. This schema does not define a sandbox or runtime loader, and declared capabilities/surfaces/providers are review metadata, not permission grants or enforcement.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "version",
    "description",
    "author",
    "license",
    "entrypoint",
    "files",
    "capabilities"
  ],
  "properties": {
    "schemaVersion": {
      "const": 3,
      "description": "Manifest contract version. 3 = PluginKit 3 (Hornero Signal): single placement (top-level entrypoint + placement) plus the optional `surfaces` map. 1 and 2 (Material-era PluginKit) are rejected; unknown versions are rejected."
    },
    "surfaces": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "description": "Extra entry points, one per surface, each independently enabled (default true). The top-level entrypoint/placement remain the primary surface; redeclaring that surface here is allowed only with the same entrypoint (to set `enabled`) — that cross-field rule is enforced by scripts/validate_plugin.py and the runtime host, not by this structural schema. Hosted today: background, bar, dashboard, desktop, settings (Control Center › Extensions). `launcher` is a validated declaration reserved for its host (launcher/search provider); no host loads it yet and declaring one grants no privilege. A bar surface shows a popover/panel with PluginKit UiPopover; it is not a separate surface.",
      "properties": {
        "background": {
          "$ref": "#/$defs/surface"
        },
        "bar": {
          "$ref": "#/$defs/surface"
        },
        "dashboard": {
          "$ref": "#/$defs/surface"
        },
        "desktop": {
          "$ref": "#/$defs/surface"
        },
        "launcher": {
          "$ref": "#/$defs/surface"
        },
        "settings": {
          "$ref": "#/$defs/surface"
        }
      }
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,47}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "\\S"
    },
    "version": {
      "maxLength": 80,
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 280,
      "pattern": "\\S"
    },
    "author": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "\\S"
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "\\S"
    },
    "homepage": {
      "type": "string",
      "maxLength": 500,
      "format": "uri",
      "pattern": "^https://[^\\s/]+(?:/.*)?$"
    },
    "signing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "publicKey",
        "signature"
      ],
      "properties": {
        "publicKey": {
          "type": "string",
          "minLength": 40,
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9+/]+={0,2}$"
        },
        "signature": {
          "type": "string",
          "minLength": 80,
          "maxLength": 120,
          "pattern": "^[A-Za-z0-9+/]+={0,2}$"
        }
      },
      "description": "Optional author signature (minisign framing) over the files-only payload hash; verified by horneroctl (trust state 'signed'). Absence is fine: local hash-pinned trust applies instead."
    },
    "placement": {
      "type": "string",
      "enum": [
        "background",
        "bar",
        "dashboard",
        "desktop"
      ],
      "default": "background",
      "description": "Where the primary (top-level) entrypoint runs: background (headless, default), bar (rendered in the bar end group) or dashboard (rendered as a card in the dashboard Extensions tab) or desktop (rendered as a widget on the desktop background layer). In schemaVersion 2, `surfaces` may add entry points on other surfaces; the primary surface stays the placement/entrypoint pair so the v1 meaning is unchanged."
    },
    "translations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceLocale",
        "locales"
      ],
      "description": "Optional per-plugin translations (any schemaVersion). The package ships one flat JSON catalog per declared locale at `<directory>/<locale>.json` (source string -> translated string), each listed in `files`; PluginKit `Translations` loads the catalog matching the shell (system) locale — full tag first, then language — and falls back to the source strings. Catalogs are source-reviewable JSON, never compiled .qm binaries. Cross-field rules (each locale's catalog listed in `files`, catalog well-formedness, coverage of the strings passed to Translations.tr()) are enforced by scripts/validate_plugin.py and the runtime host, not by this structural schema.",
      "properties": {
        "sourceLocale": {
          "type": "string",
          "pattern": "^[a-z]{2,3}(_[A-Z]{2})?$",
          "description": "Locale tag of the source strings in the package's QML, e.g. \"en\" or \"es_AR\". No catalog is needed for it: the strings in code are that locale's text."
        },
        "locales": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z]{2,3}(_[A-Z]{2})?$"
          },
          "description": "Locales the package ships a catalog for, as Qt locale tags (\"es\", \"es_AR\", \"pt_BR\")."
        },
        "directory": {
          "type": "string",
          "maxLength": 240,
          "default": "translations",
          "pattern": "^(?!/)(?!\\.{1,2}(?:/|$))(?!.*\\/\\.{1,2}(?:/|$))(?!.*//)(?!.*\\/$)[A-Za-z0-9._/-]+$",
          "description": "Package-relative directory holding the catalogs. Defaults to \"translations\"."
        }
      }
    },
    "marketplace": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "description": "Optional marketplace metadata (shell#379, any schemaVersion) the Extensions pane renders WITHOUT executing plugin code: static screenshot images shipped in the package, declared shell compatibility, a short version history, and a deprecation / replaced-by state. It grants no privilege and changes no lifecycle — install, update and rollback stay on the existing horneroctl verified provenance contracts (shell#251/#366). Cross-field rules (screenshot listed in `files`, minShellVersion <= maxShellVersion, replacedBy different from the plugin's own id) are enforced by scripts/validate_plugin.py and mirrored by the runtime host, not by this structural schema.",
      "properties": {
        "screenshots": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "description": "Static preview images shipped in `files` and shown as plain images — never QML, SVG or animated formats, so no plugin code runs to render a preview.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path"
            ],
            "properties": {
              "path": {
                "type": "string",
                "maxLength": 240,
                "pattern": "^(?!/)(?!\\.{1,2}(?:/|$))(?!.*\\/\\.{1,2}(?:/|$))(?!.*//)[A-Za-z0-9._/-]+\\.(?:png|jpg|jpeg|webp)$"
              },
              "alt": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160,
                "pattern": "\\S",
                "description": "Accessible description of the screenshot."
              }
            }
          }
        },
        "compatibility": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "description": "Declared Hornero Shell version range (semantic versions, both bounds inclusive). Review metadata shown to users; it does not gate loading.",
          "properties": {
            "minShellVersion": {
              "type": "string",
              "maxLength": 80,
              "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$"
            },
            "maxShellVersion": {
              "type": "string",
              "maxLength": 80,
              "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$"
            }
          }
        },
        "changelog": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "description": "Version history, newest first; one short notes string per released version.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "version",
              "notes"
            ],
            "properties": {
              "version": {
                "type": "string",
                "maxLength": 80,
                "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$"
              },
              "notes": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000,
                "pattern": "\\S"
              }
            }
          }
        },
        "deprecation": {
          "type": "object",
          "additionalProperties": false,
          "description": "Presence alone means the plugin is deprecated. The Extensions pane warns, stops offering new installs of a deprecated catalogue entry, and points at `replacedBy` when given; already-installed copies keep their existing lifecycle (disable/update/rollback unchanged).",
          "properties": {
            "message": {
              "type": "string",
              "minLength": 1,
              "maxLength": 280,
              "pattern": "\\S"
            },
            "replacedBy": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,47}$",
              "description": "Plugin id of the replacement (must differ from this plugin's id)."
            }
          }
        }
      }
    },
    "entrypoint": {
      "type": "string",
      "maxLength": 240,
      "pattern": "^(?!/)(?!\\.{1,2}(?:/|$))(?!.*\\/\\.{1,2}(?:/|$))(?!.*//)[A-Za-z0-9._/-]+\\.qml$"
    },
    "files": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "allOf": [
        {
          "contains": {
            "const": "README.md"
          }
        },
        {
          "contains": {
            "const": "LICENSE"
          }
        }
      ],
      "items": {
        "type": "string",
        "maxLength": 240,
        "pattern": "^(?!/)(?!\\.{1,2}(?:/|$))(?!.*\\/\\.{1,2}(?:/|$))(?!.*//)[A-Za-z0-9._/-]+$",
        "not": {
          "const": "manifest.json"
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "processCommands",
        "networkHosts",
        "settings"
      ],
      "properties": {
        "processCommands": {
          "description": "Exact executable basenames the extension may invoke. Declarations are review metadata, not enforcement.",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(?!(?:[sS][hH]|[bB][aA][sS][hH]|[dD][aA][sS][hH]|[zZ][sS][hH]|[fF][iI][sS][hH]|[sS][uU][dD][oO]|[dD][oO][aA][sS]|[sS][uU])$)[A-Za-z0-9_.+-]+$"
          }
        },
        "networkHosts": {
          "description": "Network hostnames the extension intends to contact. Declarations are review metadata, not enforcement.",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?\\.)*[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?$"
          }
        },
        "settings": {
          "description": "Typed extension settings (shell#374, schema v2 in PluginKit 4). Each declaration drives the generated Control Center settings UI and the PluginKit Settings facade: exact type plus declared constraints are validated on read and write, invalid stored values fall back to `default` (migration), and reset removes the stored value. The base types are boolean, integer, number, string and enum; PluginKit 4 (`pluginKit: 4`) adds colour, list, text and path plus display-only fields title, group, unit, step and visibleWhen. A path setting is a string the Shell never opens; its default must be empty or a safe relative path. Cross-field rules JSON Schema cannot express (minimum <= maximum, default inside its range/length, enum default listed in options, visibleWhen referencing a real sibling without cycles, level-4 features requiring pluginKit 4) are enforced by scripts/validate_plugin.py and mirrored by the runtime (services/Plugins.qml).",
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z][a-zA-Z0-9]{0,47}$"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "default"
            ],
            "properties": {
              "type": {
                "enum": [
                  "boolean",
                  "integer",
                  "number",
                  "string",
                  "enum",
                  "colour",
                  "list",
                  "text",
                  "path"
                ]
              },
              "default": {
                "type": [
                  "boolean",
                  "integer",
                  "number",
                  "string",
                  "array"
                ]
              },
              "description": {
                "type": "string",
                "maxLength": 160,
                "pattern": "\\S"
              },
              "minimum": {
                "type": "number"
              },
              "maximum": {
                "type": "number"
              },
              "minLength": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4096
              },
              "maxLength": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4096
              },
              "options": {
                "type": "array",
                "minItems": 1,
                "maxItems": 32,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                }
              },
              "step": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "unit": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8,
                "pattern": "\\S"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 48,
                "pattern": "\\S"
              },
              "group": {
                "type": "string",
                "minLength": 1,
                "maxLength": 32,
                "pattern": "\\S"
              },
              "visibleWhen": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "key",
                  "equals"
                ],
                "properties": {
                  "key": {
                    "type": "string",
                    "pattern": "^[a-z][a-zA-Z0-9]{0,47}$"
                  },
                  "equals": {
                    "type": [
                      "boolean",
                      "integer",
                      "number",
                      "string",
                      "array"
                    ]
                  }
                }
              },
              "alpha": {
                "type": "boolean"
              },
              "minItems": {
                "type": "integer",
                "minimum": 0,
                "maximum": 32
              },
              "maxItems": {
                "type": "integer",
                "minimum": 0,
                "maximum": 32
              },
              "rows": {
                "type": "integer",
                "minimum": 1,
                "maximum": 12
              },
              "kind": {
                "enum": [
                  "file",
                  "directory"
                ]
              },
              "mustExist": {
                "type": "boolean"
              }
            },
            "oneOf": [
              {
                "properties": {
                  "type": {
                    "const": "boolean"
                  },
                  "default": {
                    "type": "boolean"
                  }
                },
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "minimum"
                      ]
                    },
                    {
                      "required": [
                        "maximum"
                      ]
                    },
                    {
                      "required": [
                        "minLength"
                      ]
                    },
                    {
                      "required": [
                        "maxLength"
                      ]
                    },
                    {
                      "required": [
                        "options"
                      ]
                    },
                    {
                      "required": [
                        "step"
                      ]
                    },
                    {
                      "required": [
                        "unit"
                      ]
                    },
                    {
                      "required": [
                        "alpha"
                      ]
                    },
                    {
                      "required": [
                        "minItems"
                      ]
                    },
                    {
                      "required": [
                        "maxItems"
                      ]
                    },
                    {
                      "required": [
                        "rows"
                      ]
                    },
                    {
                      "required": [
                        "kind"
                      ]
                    },
                    {
                      "required": [
                        "mustExist"
                      ]
                    }
                  ]
                }
              },
              {
                "properties": {
                  "type": {
                    "const": "integer"
                  },
                  "default": {
                    "type": "integer"
                  },
                  "minimum": {
                    "type": "integer"
                  },
                  "maximum": {
                    "type": "integer"
                  },
                  "step": {
                    "type": "integer",
                    "exclusiveMinimum": 0
                  }
                },
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "minLength"
                      ]
                    },
                    {
                      "required": [
                        "maxLength"
                      ]
                    },
                    {
                      "required": [
