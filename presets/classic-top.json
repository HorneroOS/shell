{
  "_name": "Classic Top",
  "_description": "Traditional top bar with all status icons",
  "_icon": "🖥️",
  "_iconMaterial": "vertical_align_top",
  "bar": {
    "persistent": true,
    "showOnHover": true,
    "sizes": {
      "innerWidth": 32
    },
    "status": {
      "showAudio": true,
      "showMicrophone": true,
      "showNetwork": true,
      "showBluetooth": true,
      "showBattery": true
    },
    "scrollActions": {
      "workspaces": true,
      "volume": true,
      "brightness": false
    },
    "bars": [
      {
        "edge": "top",
        "style": "attached",
        "reserve": true,
        "margin": 8,
        "thickness": 32,
        "density": "values",
        "backdrop": "solid",
        "groups": {
          "start": [
            {
              "id": "logo",
              "enabled": true,
              "options": {}
            },
            {
              "id": "workspaces",
              "enabled": true,
              "options": {}
            },
            {
              "id": "audioSlider",
              "enabled": true,
              "options": {}
            },
            {
              "id": "brightnessSlider",
              "enabled": true,
              "options": {}
            }
          ],
          "center": [
            {
              "id": "clock",
              "enabled": true,
              "options": {}
            }
          ],
          "end": [
            {
              "id": "statusIcons",
              "enabled": true,
              "options": {}
            },
            {
              "id": "power",
              "enabled": true,
              "options": {}
            }
          ]
        }
      }
    ]
  },
  "border": {
    "frameEnabled": false
  },
  "appearance": {
    "rounding": {
      "scale": 0.75
    },
    "padding": {
      "scale": 0.9
    },
    "spacing": {
      "scale": 0.9
    }
  }
}
