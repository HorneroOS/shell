{
  "schemaVersion": 3,
  "pluginKit": 4,
  "id": "example-commands",
  "name": "Example Commands",
  "version": "1.0.0",
  "description": "Contributes commands, a quick-setting tile and a Control Center panel (PluginKit 4).",
  "author": "HorneroOS contributors",
  "license": "MIT",
  "entrypoint": "Main.qml",
  "files": [
    "Main.qml",
    "Commands.qml",
    "Tile.qml",
    "Panel.qml",
    "README.md",
    "LICENSE"
  ],
  "capabilities": {
    "processCommands": [],
    "networkHosts": [],
    "settings": {
      "greeting": {
        "type": "string",
        "default": "Hello",
        "maxLength": 24,
        "title": "Greeting",
        "group": "Messages"
      },
      "reminder": {
        "type": "text",
        "default": "Stand up and stretch.",
        "rows": 2,
        "maxLength": 140,
        "title": "Reminder text",
        "group": "Messages"
      },
      "quiet": {
        "type": "boolean",
        "default": false,
        "hidden": true
      },
      "tags": {
        "type": "strings",
        "default": [
          "focus",
          "write"
        ],
        "maxItems": 8,
        "maxLength": 24,
        "title": "Tags",
        "group": "Messages"
      }
    }
  },
  "contributes": {
    "commands": [
      {
        "id": "greet",
        "title": "Say hello",
        "description": "Shows a greeting; the launcher argument is the name",
        "glyph": "bolt",
        "keywords": [
          "hello",
          "greeting"
        ]
      },
      {
        "id": "remind",
        "title": "Show reminder",
        "glyph": "bell",
        "keywords": [
          "stretch",
          "break"
        ]
      }
    ],
    "quickSettings": [
      {
        "id": "quiet",
        "title": "Quiet mode",
        "glyph": "bell",
        "kind": "toggle"
      }
    ],
    "panels": [
      {
        "id": "tags",
        "title": "Tags",
        "glyph": "layout-sidebar"
      }
    ]
  },
  "surfaces": {
    "commands": {
      "entrypoint": "Commands.qml"
    },
    "quickSetting": {
      "entrypoint": "Tile.qml"
    },
    "panel": {
      "entrypoint": "Panel.qml"
    }
  },
  "placement": "bar"
}
