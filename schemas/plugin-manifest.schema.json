                    }
                  ]
                }
              },
              {
                "properties": {
                  "type": {
                    "const": "string"
                  },
                  "default": {
                    "type": "string",
                    "maxLength": 4096
                  }
                },
                "not": {
                  "anyOf": [
                    {
                      "required": [
