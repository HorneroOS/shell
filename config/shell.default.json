{
  "appearance": {
    "theme": "hornero-signal-night",
    "highContrast": false,
    "reducedMotion": false,
    "rounding": {
      "scale": 1
    },
    "spacing": {
      "scale": 1
    },
    "padding": {
      "scale": 1
    },
    "font": {
      "family": {
        "sans": "IBM Plex Sans",
        "mono": "IBM Plex Mono",
        "display": "IBM Plex Sans Condensed"
      },
      "size": {
        "scale": 1
      },
      "weight": {
        "shift": 0
      }
    },
    "anim": {
      "mediaGifSpeedAdjustment": 300,
      "sessionGifSpeed": 0.7,
      "curveStyle": "smooth",
      "durations": {
        "scale": 1
      }
    },
    "glow": {
      "intensity": 1
    },
    "transparency": {
      "enabled": false,
      "base": 0.85,
      "layers": 0.4,
      "elements": {}
    },
    "chromatic": {
      "source": "wallpaper",
      "seeds": [],
      "variant": "auto",
      "mode": "auto",
      "contrast": "standard",
      "surfaceDepth": "standard",
      "chroma": 1,
      "hueShift": 0,
      "follow": "auto",
      "perMode": {
        "dark": {
          "variant": "auto"
        },
        "light": {
          "variant": "auto"
        }
      },
      "fallback": {
        "dark": "hornero-signal-night",
        "light": "hornero-signal-day"
      },
      "transition": "smooth"
    }
  },
  "general": {
    "logo": "",
    "apps": {
      "terminal": [
        "kitty"
      ],
      "audio": [
        "pavucontrol"
      ],
      "playback": [
        "mpv"
      ],
      "explorer": [
        "thunar"
      ]
    },
    "idle": {
      "lockBeforeSleep": true,
      "inhibitWhenAudio": true,
      "timeouts": [
        {
          "timeout": 180,
          "idleAction": "lock"
        },
        {
          "timeout": 300,
          "idleAction": "dpms off",
          "returnAction": "dpms on"
        },
        {
          "timeout": 600,
          "idleAction": [
            "systemctl",
            "suspend-then-hibernate"
          ]
        }
      ]
    },
    "battery": {
      "warnLevels": [
        {
          "level": 20,
          "title": "Low battery",
          "message": "You might want to plug in a charger",
          "icon": "battery-2"
        },
        {
          "level": 10,
          "title": "Did you see the previous message?",
          "message": "You should probably plug in a charger <b>now</b>",
          "icon": "battery-1"
        },
        {
          "level": 5,
          "title": "Critical battery level",
          "message": "PLUG THE CHARGER RIGHT NOW!!",
          "icon": "battery-exclamation",
          "critical": true
        }
      ],
      "criticalLevel": 3
    }
  },
  "background": {
    "enabled": true,
    "wallpaperEnabled": true,
    "desktopClock": {
      "enabled": false,
      "scale": 1.0,
      "position": "bottom-right",
      "invertColors": false,
      "background": {
        "enabled": false,
        "opacity": 0.7,
        "blur": true
      },
      "shadow": {
        "enabled": true,
        "opacity": 0.7,
        "blur": 0.4
      }
    },
    "visualiser": {
      "enabled": false,
      "autoHide": true,
      "blur": false,
      "rounding": 1,
      "spacing": 1
    },
    "video": {
      "enabled": true,
      "pauseOnFullscreen": true,
      "pauseOnGameMode": false,
      "batteryLimitEnabled": false,
      "batteryLimit": 20
    }
  },
