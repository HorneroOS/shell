{
  "_name": "Minimal Left",
  "_description": "Clean left sidebar — workspaces and power only",
  "_icon": "✨",
  "_iconMaterial": "view_sidebar",
  "bar": {
    "persistent": true,
    "showOnHover": true,
    "sizes": {
      "innerWidth": 32
    },
    "status": {},
    "scrollActions": {
      "workspaces": true,
      "volume": true,
      "brightness": true
    },
    "bars": [
      {
        "edge": "left",
        "style": "attached",
        "reserve": true,
        "margin": 8,
        "thickness": 32,
        "density": "values",
        "backdrop": "solid",
        "groups": {
          "start": [
            {
              "id": "logo",
              "enabled": true,
              "options": {}
            },
            {
              "id": "workspaces",
              "enabled": true,
              "options": {}
            }
          ],
          "center": [],
          "end": [
            {
              "id": "power",
              "enabled": true,
              "options": {}
            }
          ]
        }
      }
    ]
  },
  "border": {
    "frameEnabled": false
  },
  "appearance": {
    "rounding": {
      "scale": 1.2
    },
    "padding": {
      "scale": 0.9
    },
    "spacing": {
      "scale": 0.9
    }
  }
}
