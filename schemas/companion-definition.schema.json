{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://horneroos.dev/schemas/companion-definition.schema.json",
  "title": "Hornero data-only companion definition v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "version",
    "names",
    "provenance",
    "preview",
    "canvas",
    "defaultSkin",
    "skins",
    "capabilities"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-zA-Z0-9]{0,31}$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$"
    },
    "names": {
      "$ref": "#/$defs/localized48"
    },
    "descriptions": {
      "$ref": "#/$defs/localized280"
    },
    "archetype": {
      "type": "string",
      "pattern": "^[a-z][a-zA-Z0-9]{0,31}$"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "author",
        "license"
      ],
      "properties": {
        "author": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "license": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "source": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "attribution": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "tool": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        }
      }
    },
    "preview": {
      "type": "string",
      "maxLength": 240
    },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height",
        "anchors"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 32,
          "maximum": 2048
        },
        "height": {
          "type": "integer",
          "minimum": 32,
          "maximum": 2048
        },
        "anchors": {
          "type": "object",
          "minProperties": 2,
          "maxProperties": 16,
          "required": [
            "ground",
            "center"
          ],
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2048
            },
            "minItems": 2,
            "maxItems": 2
          }
        }
      }
    },
    "defaultSkin": {
      "type": "string",
      "pattern": "^[a-z][a-zA-Z0-9]{0,31}$"
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "enum": [
          "stationary",
          "grounded",
          "walk",
          "fly",
          "swim",
          "climb",
          "roll",
          "burrow",
          "perch",
          "talk",
          "listen",
          "think",
          "work",
          "sleep",
          "greet",
          "celebrate",
          "concern"
        ]
      }
    },
    "skins": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 16,
      "additionalProperties": {
        "$ref": "#/$defs/skin"
      }
    },
    "personality": {
      "$ref": "#/$defs/personality"
    },
    "habitat": {
      "$ref": "#/$defs/habitat"
    },
    "assistantCompatibility": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "enum": [
          "none",
          "hermes",
          "veasel"
        ]
      }
    }
  },
  "$defs": {
    "localized48": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 16,
      "required": [
        "en"
      ],
      "propertyNames": {
        "pattern": "^[a-z]{2,3}(_[A-Z]{2})?$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 48
      }
    },
    "localized280": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 16,
      "required": [
        "en"
      ],
      "propertyNames": {
        "pattern": "^[a-z]{2,3}(_[A-Z]{2})?$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 280
      }
    },
    "localized120": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 16,
      "propertyNames": {
        "pattern": "^[a-z]{2,3}(_[A-Z]{2})?$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
      }
    },
    "action": {
      "enum": [
        "idle",
        "blink",
        "look",
        "greet",
        "walk",
        "move",
        "appear",
        "leave",
        "rest",
        "sleep",
        "talk",
        "listen",
        "think",
        "work",
        "approve",
        "celebrate",
        "deny",
        "worry",
        "error",
        "drag",
        "peek",
        "hover",
        "takeoff",
        "fly",
        "land",
        "perch",
        "hop",
        "preen",
        "stretch",
        "swim",
        "climb",
        "roll",
        "burrow"
      ]
    },
    "skin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "names",
        "animations"
      ],
      "properties": {
        "names": {
          "$ref": "#/$defs/localized48"
        },
        "palette": {
          "type": "object",
          "maxProperties": 32,
          "additionalProperties": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?$"
          }
        },
        "animations": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 32,
          "required": [
            "idle"
          ],
          "propertyNames": {
            "$ref": "#/$defs/action"
          },
          "additionalProperties": {
            "$ref": "#/$defs/animation"
          }
        },
        "accessories": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/accessory"
          }
        },
        "defaultAccessories": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-zA-Z0-9]{0,31}$"
          }
        }
      }
    },
    "animation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "frames": {
          "type": "array",
          "minItems": 1,
          "maxItems": 120,
          "items": {
            "$ref": "#/$defs/frame"
          }
        },
        "atlas": {
          "$ref": "#/$defs/atlas"
        },
        "frameMs": {
          "type": "integer",
          "minimum": 40,
          "maximum": 10000
        },
        "loop": {
          "type": "boolean"
        },
        "next": {
          "$ref": "#/$defs/action"
        },
        "anchor": {
          "type": "string",
          "maxLength": 32
        },
        "fallbacks": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/action"
          }
        },
        "reducedMotionFrame": {
          "type": "integer",
          "minimum": 0
        }
      },
      "oneOf": [
        {
          "required": [
            "frames"
          ]
        },
        {
          "required": [
            "atlas"
          ]
        }
      ]
    },
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "file": {
          "type": "string",
          "maxLength": 240
        },
        "layers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "string",
            "maxLength": 240
          }
        },
        "ms": {
          "type": "integer",
          "minimum": 40,
          "maximum": 10000
        }
      },
      "oneOf": [
        {
          "required": [
            "file"
          ]
        },
        {
          "required": [
            "layers"
          ]
        }
      ]
    },
    "atlas": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file",
        "frameWidth",
        "frameHeight",
        "columns",
        "count"
      ],
      "properties": {
        "file": {
          "type": "string",
          "maxLength": 240
        },
        "frameWidth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2048
        },
        "frameHeight": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2048
        },
        "columns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120
        },
        "durations": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 40,
            "maximum": 10000
          }
        }
      }
    },
    "accessory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "names",
        "file"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-zA-Z0-9]{0,31}$"
        },
        "names": {
          "$ref": "#/$defs/localized48"
        },
        "file": {
          "type": "string",
          "maxLength": 240
        },
        "zIndex": {
          "type": "integer",
          "minimum": -2,
          "maximum": 2
        }
      }
    },
    "personality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "default",
        "options"
      ],
      "properties": {
        "default": {
          "type": "string",
          "pattern": "^[a-z][a-zA-Z0-9]{0,31}$"
        },
        "options": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "names",
              "traits"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-zA-Z0-9]{0,31}$"
              },
              "names": {
                "$ref": "#/$defs/localized48"
              },
              "traits": {
                "type": "array",
                "minItems": 1,
                "maxItems": 6,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "calm",
                    "playful",
                    "curious",
                    "focused",
                    "quiet",
                    "cheerful",
                    "sleepy",
                    "mischievous",
                    "gentle",
                    "technical"
                  ]
                }
              },
              "lines": {
                "type": "object",
                "maxProperties": 16,
                "propertyNames": {
                  "$ref": "#/$defs/action"
                },
                "additionalProperties": {
                  "$ref": "#/$defs/localized120"
                }
              }
            }
          }
        }
      }
    },
    "habitat": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "names",
        "image",
        "anchor"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-zA-Z0-9]{0,31}$"
        },
        "names": {
          "$ref": "#/$defs/localized48"
        },
        "image": {
          "type": "string",
          "maxLength": 240
        },
        "anchor": {
          "type": "string",
          "maxLength": 32
        },
        "defaultScale": {
          "type": "number",
          "minimum": 0.25,
          "maximum": 3
        },
        "sleepAnimation": {
          "$ref": "#/$defs/action"
        }
      }
    }
  }
}
