{
  "_name": "Hornero Left",
  "_description": "Left sidebar — full featured, reference shell style",
  "_icon": "🏠",
  "_iconMaterial": "dock_to_left",
  "bar": {
    "persistent": true,
    "showOnHover": true,
    "sizes": {
      "innerWidth": 40
    },
    "status": {
      "showAudio": true,
      "showMicrophone": true,
      "showNetwork": true,
      "showBluetooth": true,
      "showBattery": true
    },
    "scrollActions": {
      "workspaces": true,
      "volume": true,
      "brightness": true
    },
    "bars": [
      {
        "edge": "left",
        "style": "attached",
        "reserve": true,
        "margin": 8,
        "thickness": 40,
        "density": "values",
        "backdrop": "solid",
        "groups": {
          "start": [
            {
              "id": "logo",
              "enabled": true,
              "options": {}
            },
            {
              "id": "workspaces",
              "enabled": true,
              "options": {}
            }
          ],
          "center": [
            {
              "id": "activeWindow",
              "enabled": true,
              "options": {}
            }
          ],
          "end": [
            {
              "id": "tray",
              "enabled": true,
              "options": {}
            },
            {
              "id": "clock",
              "enabled": true,
              "options": {}
            },
            {
              "id": "statusIcons",
              "enabled": true,
              "options": {}
            },
            {
              "id": "power",
              "enabled": true,
              "options": {}
            }
          ]
        }
      }
    ]
  },
  "border": {
    "frameEnabled": true
  },
  "appearance": {
    "rounding": {
      "scale": 1.0
    },
    "padding": {
      "scale": 1.0
    },
    "spacing": {
      "scale": 1.0
    }
  }
}
