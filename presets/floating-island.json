{
  "_name": "Floating Island",
  "_description": "One compact floating module: workspaces, clock and status in a hairline frame",
  "_icon": "🏝️",
  "_glyph": "app-window",
  "bar": {
    "persistent": true,
    "showOnHover": true,
    "sizes": {
      "innerWidth": 24
    },
    "status": {
      "showAudio": true,
      "showMicrophone": false,
      "showNetwork": true,
      "showBluetooth": true,
      "showBattery": true
    },
    "scrollActions": {
      "workspaces": true,
      "volume": true,
      "brightness": false
    },
    "bars": [
      {
        "edge": "top",
        "style": "floating",
        "margin": 10,
        "reserve": true,
        "thickness": 34,
        "density": "values",
        "backdrop": "solid",
        "groups": {
          "start": [
            {
              "id": "logo",
              "enabled": true
            },
            {
              "id": "workspaces",
              "enabled": true
            }
          ],
          "center": [
            {
              "id": "clock",
              "enabled": true,
              "options": {
                "showDate": false
              }
            }
          ],
          "end": [
            {
              "id": "statusIcons",
              "enabled": true
            },
            {
              "id": "power",
              "enabled": true
            }
          ]
        }
      }
    ]
  },
  "border": {
    "frameEnabled": false
  },
  "appearance": {
    "rounding": {
      "scale": 1.0
    },
    "padding": {
      "scale": 1.0
    },
    "spacing": {
      "scale": 1.0
    }
  }
}
