{
  "_name": "Cockpit",
  "_description": "Two bars: act on top, glance below — a classic desktop composition",
  "_icon": "🛫",
  "_iconMaterial": "view_agenda",
  "_lineage": "Polybar default + Waybar default profiles",
  "bar": {
    "persistent": true,
    "showOnHover": true,
    "bars": [
      {
        "edge": "top",
        "style": "inset",
        "margin": 8,
        "groups": {
          "start": [
            {
              "id": "logo",
              "enabled": true
            },
            {
              "id": "quickActions",
              "enabled": true,
              "options": {
                "actions": [
                  "screenshot",
                  "layoutPicker",
                  "settings"
                ]
              }
            },
            {
              "id": "audioSlider",
              "enabled": true,
              "options": {
                "showValue": true
              }
            },
            {
              "id": "brightnessSlider",
              "enabled": true,
              "options": {
                "showValue": true
              }
            }
          ],
          "center": [
            {
              "id": "clock",
              "enabled": true,
              "options": {
                "showDate": true
              }
            },
            {
              "id": "weather",
              "enabled": true
            }
          ],
          "end": [
            {
              "id": "battery",
              "enabled": true
            },
            {
              "id": "statusIcons",
              "enabled": true
            },
            {
              "id": "tray",
              "enabled": true
            },
            {
              "id": "power",
              "enabled": true
            }
          ]
        },
        "reserve": true,
        "thickness": 40,
        "density": "values",
        "backdrop": "solid"
      },
      {
        "edge": "bottom",
        "style": "attached",
        "thickness": 32,
        "groups": {
          "start": [
            {
              "id": "workspaces",
              "enabled": true
            }
          ],
          "center": [
            {
              "id": "media",
              "enabled": true
            }
          ],
          "end": [
            {
              "id": "kbLayout",
              "enabled": true
            },
            {
              "id": "resources",
              "enabled": true
            }
          ]
        },
        "reserve": true,
        "margin": 8,
        "density": "values",
        "backdrop": "solid"
      }
    ],
    "sizes": {
      "innerWidth": 32
    },
    "status": {
      "showAudio": true,
      "showMicrophone": false,
      "showNetwork": true,
      "showBluetooth": true,
      "showBattery": false
    },
    "scrollActions": {
      "workspaces": true,
      "volume": true,
      "brightness": true
    }
  },
  "border": {
    "frameEnabled": false
  }
}
