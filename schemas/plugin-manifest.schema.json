                    },
                    {
                      "required": [
                        "step"
                      ]
                    },
                    {
                      "required": [
                        "unit"
                      ]
                    },
                    {
                      "required": [
                        "alpha"
                      ]
                    },
                    {
                      "required": [
                        "minItems"
                      ]
                    },
                    {
                      "required": [
                        "maxItems"
                      ]
                    },
                    {
                      "required": [
                        "kind"
                      ]
                    },
                    {
                      "required": [
                        "mustExist"
                      ]
                    }
                  ]
                }
              },
              {
                "properties": {
                  "type": {
                    "const": "path"
                  },
                  "default": {
                    "type": "string",
                    "maxLength": 1024
                  }
                },
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "minimum"
                      ]
                    },
                    {
                      "required": [
                        "maximum"
                      ]
                    },
                    {
                      "required": [
                        "minLength"
                      ]
                    },
                    {
                      "required": [
                        "maxLength"
                      ]
                    },
                    {
                      "required": [
                        "options"
                      ]
                    },
                    {
                      "required": [
                        "step"
                      ]
                    },
                    {
                      "required": [
                        "unit"
                      ]
                    },
                    {
                      "required": [
                        "alpha"
                      ]
                    },
                    {
                      "required": [
                        "minItems"
                      ]
                    },
                    {
                      "required": [
                        "maxItems"
                      ]
                    },
                    {
                      "required": [
                        "rows"
                      ]
                    }
                  ]
                }
              }
            ]
          }
        },
        "actions": {
          "description": "Optional horneroctl plugin-broker action names (HorneroOS/hornero#408) the extension declares it may request through the typed capability broker (snake_case ids such as system_info or notify). Declarations are review metadata: the broker enforces trust, declaration, typed argv and ABAC at call time, and an undeclared action is refused there. Catalogue membership is enforced by the broker, not by this schema, so the catalogue can grow without a manifest migration.",
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          }
        },
        "providers": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "system",
              "network",
              "spectrum",
              "media",
              "audio",
              "power",
              "weather",
              "time",
              "workspaces"
            ]
          },
          "description": "Shared PluginKit data-provider domains (RFC 0001 §5b) the extension reads. Every facade or Subscription domain used in QML must be declared; scripts/validate_plugin.py cross-checks it. Review metadata, not enforcement: extension QML is not sandboxed."
        }
      }
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "templates"
      ],
      "description": "Optional palette templates (any schemaVersion, RFC 0002). Each entry names a package file (`template`, a .tmpl listed in `files`) and a plain output file name. horneroctl renders the template from the live palette whenever it changes and writes `output` under ${XDG_CACHE_HOME}/hornero/themes/ext/<plugin id>/; the extension never runs a command on a palette change. Template grammar and cross-field rules (file listed, unique outputs) are enforced by scripts/validate_plugin.py, not by this structural schema.",
      "properties": {
        "templates": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "template",
              "output"
            ],
            "properties": {
              "template": {
                "type": "string",
                "pattern": "^[A-Za-z0-9._/-]+\\.tmpl$",
                "maxLength": 240
              },
              "output": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
              }
            }
          }
        }
      }
    },
    "pluginKit": {
      "type": "integer",
      "minimum": 3,
      "maximum": 4,
      "default": 3,
      "description": "Minimum PluginKit apiLevel the package needs (RFC 0003). Defaults to 3. Features that exist only from level 4 (colour/list/text/path settings, title/group/unit/step/visibleWhen, contributes, instances) must declare 4; scripts/validate_plugin.py enforces that a package cannot under-declare, and a Shell whose kit is older refuses the package plainly."
    }
  },
  "$defs": {
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entrypoint"
      ],
      "properties": {
        "entrypoint": {
          "type": "string",
          "maxLength": 240,
          "pattern": "^(?!/)(?!\\.{1,2}(?:/|$))(?!.*\\/\\.{1,2}(?:/|$))(?!.*//)[A-Za-z0-9._/-]+\\.qml$"
        },
        "enabled": {
          "type": "boolean",
          "default": true,
          "description": "Whether this surface is enabled by default. A disabled surface is not loaded by its host; other surfaces of the same package are unaffected."
        },
        "size": {
          "type": "string",
          "enum": [
            "compact",
            "standard",
            "wide"
          ],
          "default": "standard",
          "description": "Dashboard surface only (shell#378): preferred card size class in the composable dashboard layout. A hint the user's persisted layout overrides; declaring it on another surface is rejected by scripts/validate_plugin.py and the runtime host, not by this structural schema."
        },
        "category": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "pattern": "\\S",
          "description": "Dashboard surface only (shell#378): grouping label under which the dashboard shows this card (uncategorized cards group under Other; \"Pinned\" is reserved for user-pinned cards). Same enforcement split as `size`."
        },
        "section": {
          "type": "string",
          "enum": [
            "status",
            "actions",
            "clock",
            "end"
          ],
          "default": "end",
          "description": "Bar surface only (shell#439): the native bar section the indicator joins — status (status icons island), actions (quick actions island), clock (clock island) or end (after the end group, the historic placement). The host renders it inside that island with the island's own icon colour and size. Declaring it on another surface is rejected by scripts/validate_plugin.py and the runtime host, not by this structural schema."
        },
        "width": {
          "type": "integer",
          "minimum": 80,
          "maximum": 1600,
          "description": "Desktop surface only (PluginKit 3): the widget's default width in logical pixels. The person's saved geometry wins. Declaring it on another surface is rejected by scripts/validate_plugin.py and the runtime host."
        },
        "height": {
          "type": "integer",
          "minimum": 80,
          "maximum": 1600,
          "description": "Desktop surface only (PluginKit 3): the widget's default height in logical pixels. The person's saved geometry wins. Declaring it on another surface is rejected by scripts/validate_plugin.py and the runtime host."
        },
        "minWidth": {
          "type": "integer",
          "minimum": 80,
          "maximum": 1600,
          "description": "Desktop surface only (PluginKit 3): the widget's minimum width in logical pixels. The person's saved geometry wins. Declaring it on another surface is rejected by scripts/validate_plugin.py and the runtime host."
        },
        "minHeight": {
          "type": "integer",
          "minimum": 80,
          "maximum": 1600,
          "description": "Desktop surface only (PluginKit 3): the widget's minimum height in logical pixels. The person's saved geometry wins. Declaring it on another surface is rejected by scripts/validate_plugin.py and the runtime host."
        },
        "resizable": {
          "type": "boolean",
          "default": true,
          "description": "Desktop surface only: whether the person may resize the widget in edit mode."
        },
        "anchor": {
          "type": "string",
          "enum": [
            "top-left",
            "top-center",
            "top-right",
            "middle-left",
            "middle-center",
            "middle-right",
            "bottom-left",
            "bottom-center",
            "bottom-right"
          ],
          "default": "bottom-right",
          "description": "Desktop surface only: where the widget starts on a screen before the person moves it."
        }
      }
    }
  }
}
