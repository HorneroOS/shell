{
  "schemaVersion": 2,
  "id": "example-multi-surface",
  "name": "Example Multi-Surface",
  "version": "1.0.0",
  "description": "A manifest v2 example: one package with a bar indicator (primary placement) plus a dashboard card from the surfaces map.",
  "author": "HorneroOS contributors",
  "license": "MIT",
  "entrypoint": "Main.qml",
  "files": [
    "Main.qml",
    "Dashboard.qml",
    "README.md",
    "LICENSE"
  ],
  "capabilities": {
    "processCommands": [],
    "networkHosts": [],
    "settings": {
      "label": {
        "type": "string",
        "default": "HorneroOS"
      }
    }
  },
  "placement": "bar",
  "surfaces": {
    "dashboard": {
      "entrypoint": "Dashboard.qml"
    }
  }
}
