{
  "_name": "Islands",
  "_description": "Three floating islands: controls, time, status",
  "_icon": "🏝️",
  "_iconMaterial": "view_column",
  "_lineage": "Polybar i3 multipart profile",
  "bar": {
    "persistent": true,
    "showOnHover": true,
    "bars": [
      {
        "edge": "top",
        "style": "islands",
        "margin": 10,
        "groups": {
          "start": [
            {
              "id": "logo",
              "enabled": true
            },
            {
              "id": "quickActions",
              "enabled": true,
              "options": {
                "actions": [
                  "screenshot",
                  "layoutPicker",
                  "settings"
                ]
              }
            },
            {
              "id": "audioSlider",
              "enabled": true
            },
            {
              "id": "brightnessSlider",
              "enabled": true
            }
          ],
          "center": [
            {
              "id": "clock",
              "enabled": true
            },
            {
              "id": "weather",
              "enabled": true
            }
          ],
          "end": [
            {
              "id": "battery",
              "enabled": true
            },
            {
              "id": "statusIcons",
              "enabled": true
            },
            {
              "id": "tray",
              "enabled": true
            },
            {
              "id": "power",
              "enabled": true
            }
          ]
        },
        "reserve": true,
        "thickness": 40,
        "density": "values",
        "backdrop": "solid"
      }
    ],
    "sizes": {
      "innerWidth": 32
    },
    "status": {
      "showAudio": true,
      "showMicrophone": false,
      "showNetwork": true,
      "showBluetooth": true,
      "showBattery": false
    },
    "scrollActions": {
      "workspaces": true,
      "volume": true,
      "brightness": true
    }
  },
  "border": {
    "frameEnabled": false
  }
}
