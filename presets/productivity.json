{
  "_name": "Productivity",
  "_description": "Top bar optimized for focused work — no distractions",
  "_icon": "💼",
  "_iconMaterial": "work",
  "bar": {
    "persistent": true,
    "showOnHover": true,
    "sizes": {
      "innerWidth": 32
    },
    "status": {
      "showAudio": true,
      "showNetwork": true,
      "showBattery": true
    },
    "scrollActions": {
      "workspaces": true,
      "volume": true,
      "brightness": false
    },
    "bars": [
      {
        "edge": "top",
        "style": "attached",
        "reserve": true,
        "margin": 8,
        "thickness": 32,
        "density": "values",
        "backdrop": "solid",
        "groups": {
          "start": [
            {
              "id": "workspaces",
              "enabled": true,
              "options": {}
            },
            {
              "id": "activeWindow",
              "enabled": true,
              "options": {}
            }
          ],
          "center": [
            {
              "id": "clock",
              "enabled": true,
              "options": {}
            }
          ],
          "end": [
            {
              "id": "statusIcons",
              "enabled": true,
              "options": {}
            },
            {
              "id": "power",
              "enabled": true,
              "options": {}
            }
          ]
        }
      }
    ]
  },
  "border": {
    "frameEnabled": false
  },
  "appearance": {
    "rounding": {
      "scale": 0.75
    },
    "padding": {
      "scale": 0.8
    },
    "spacing": {
      "scale": 0.9
    }
  },
  "notifs": {
    "defaultExpireTimeout": 4000
  }
}
