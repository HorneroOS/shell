{
  "_name": "Studio",
  "_description": "Top bar for creative work — media and audio at hand, stable reserved canvas",
  "_icon": "🎬",
  "_iconMaterial": "movie_creation",
  "bar": {
    "persistent": true,
    "showOnHover": true,
    "sizes": {
      "innerWidth": 32
    },
    "status": {
      "showAudio": true,
      "showMicrophone": true,
      "showNetwork": true,
      "showBattery": true
    },
    "scrollActions": {
      "workspaces": true,
      "volume": true,
      "brightness": true
    },
    "bars": [
      {
        "edge": "top",
        "style": "attached",
        "reserve": true,
        "margin": 8,
        "thickness": 32,
        "density": "values",
        "backdrop": "solid",
        "groups": {
          "start": [
            {
              "id": "logo",
              "enabled": true,
              "options": {}
            },
            {
              "id": "workspaces",
              "enabled": true,
              "options": {}
            },
            {
              "id": "activeWindow",
              "enabled": true,
              "options": {}
            }
          ],
          "center": [
            {
              "id": "media",
              "enabled": true,
              "options": {}
            },
            {
              "id": "clock",
              "enabled": true,
              "options": {}
            }
          ],
          "end": [
            {
              "id": "audioSlider",
              "enabled": true,
              "options": {}
            },
            {
              "id": "resources",
              "enabled": true,
              "options": {}
            },
            {
              "id": "statusIcons",
              "enabled": true,
              "options": {}
            },
            {
              "id": "power",
              "enabled": true,
              "options": {}
            }
          ]
        }
      }
    ]
  },
  "border": {
    "frameEnabled": false
  },
  "appearance": {
    "rounding": {
      "scale": 0.85
    },
    "padding": {
      "scale": 0.85
    },
    "spacing": {
      "scale": 0.9
    }
  },
  "notifs": {
    "defaultExpireTimeout": 5000
  },
  "background": {
    "visualiser": {
      "enabled": true,
      "autoHide": true
    },
    "desktopClock": {
      "enabled": false
    }
  }
}
