{
  "schemaVersion": 3,
  "id": "example-desktop-note",
  "name": "Example Desktop Note",
  "version": "1.0.0",
  "description": "A minimal desktop widget example for the Hornero Shell extension contract (PluginKit 3).",
  "author": "HorneroOS contributors",
  "license": "MIT",
  "entrypoint": "Main.qml",
  "files": [
    "Main.qml",
    "README.md",
    "LICENSE"
  ],
  "capabilities": {
    "processCommands": [],
    "networkHosts": [],
    "settings": {
      "note": {
        "type": "string",
        "default": "El futuro se construye acá."
      }
    }
  },
  "placement": "desktop",
  "surfaces": {
    "desktop": {
      "entrypoint": "Main.qml",
      "width": 320,
      "height": 148,
      "minWidth": 240,
      "minHeight": 120,
      "anchor": "bottom-right"
    }
  }
}
