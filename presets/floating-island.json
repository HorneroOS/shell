{
  "_name": "Floating Island",
  "_description": "Pill-shaped floating island on top — glassy and glowy",
  "_icon": "🏝️",
  "_iconMaterial": "web_asset",
  "bar": {
    "persistent": true,
    "showOnHover": true,
    "sizes": {
      "innerWidth": 32
    },
    "status": {
      "showAudio": true,
      "showNetwork": true,
      "showBluetooth": true,
      "showBattery": true
    },
    "scrollActions": {
      "workspaces": true,
      "volume": true,
      "brightness": false
    },
    "bars": [
      {
        "edge": "top",
        "style": "floating",
        "margin": 16,
        "reserve": true,
        "groups": {
          "start": [
            {
              "id": "logo",
              "enabled": true
            },
            {
              "id": "workspaces",
              "enabled": true
            }
          ],
          "center": [
            {
              "id": "clock",
              "enabled": true
            }
          ],
          "end": [
            {
              "id": "statusIcons",
              "enabled": true
            },
            {
              "id": "power",
              "enabled": true
            }
          ]
        },
        "thickness": 40,
        "density": "values",
        "backdrop": "solid"
      }
    ]
  },
  "border": {
    "frameEnabled": false
  },
  "appearance": {
    "rounding": {
      "scale": 1.6
    },
    "padding": {
      "scale": 1.0
    },
    "spacing": {
      "scale": 1.0
    },
    "transparency": {
      "enabled": true,
      "base": 0.8,
      "layers": 0.5
    }
  }
}
