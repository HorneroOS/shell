{
  "schemaVersion": 1,
  "id": "example-clock",
  "name": "Example Clock",
  "version": "1.0.0",
  "description": "A minimal example package for the Hornero Shell extension contract.",
  "author": "HorneroOS contributors",
  "license": "MIT",
  "entrypoint": "Main.qml",
  "files": [
    "Main.qml",
    "README.md",
    "LICENSE",
    "translations/es.json"
  ],
  "translations": {
    "sourceLocale": "en",
    "locales": ["es"],
    "directory": "translations"
  },
  "capabilities": {
    "processCommands": [],
    "networkHosts": [],
    "settings": {
      "twentyFourHour": {
        "type": "boolean",
        "default": true,
        "description": "Show the time in 24-hour format instead of 12-hour AM/PM."
      }
    }
  },
  "placement": "bar"
}
