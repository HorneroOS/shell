{
  "_name": "Gaming",
  "_description": "Bottom bar — minimal footprint, no logo",
  "_icon": "🎮",
  "_iconMaterial": "sports_esports",
  "bar": {
    "persistent": true,
    "showOnHover": true,
    "sizes": {
      "innerWidth": 32
    },
    "status": {
      "showAudio": true,
      "showNetwork": true
    },
    "scrollActions": {
      "workspaces": true,
      "volume": true,
      "brightness": false
    },
    "bars": [
      {
        "edge": "bottom",
        "style": "floating",
        "reserve": false,
        "margin": 14,
        "thickness": 32,
        "density": "values",
        "backdrop": "solid",
        "groups": {
          "start": [
            {
              "id": "workspaces",
              "enabled": true,
              "options": {}
            }
          ],
          "center": [],
          "end": [
            {
              "id": "statusIcons",
              "enabled": true,
              "options": {}
            }
          ]
        }
      }
    ]
  },
  "border": {
    "frameEnabled": false
  },
  "appearance": {
    "rounding": {
      "scale": 0.9
    },
    "padding": {
      "scale": 0.7
    },
    "spacing": {
      "scale": 0.8
    }
  },
  "notifs": {
    "defaultExpireTimeout": 2000
  },
  "osd": {
    "hideDelay": 1000
  },
  "background": {
    "visualiser": {
      "enabled": true,
      "autoHide": false
    },
    "desktopClock": {
      "enabled": false
    }
  }
}
