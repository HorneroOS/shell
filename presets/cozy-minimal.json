{
  "_name": "Minimal Float",
  "_description": "Soft floating top ribbon — workspaces, centred time, a few tools",
  "_glyph": "armchair",
  "_lineage": "Waybar cozy-minimal profile",
  "bar": {
    "persistent": true,
    "showOnHover": true,
    "bars": [
      {
        "edge": "top",
        "style": "floating",
        "margin": 8,
        "groups": {
          "start": [
            {
              "id": "logo",
              "enabled": true
            },
            {
              "id": "workspaces",
              "enabled": true
            }
          ],
          "center": [
            {
              "id": "clock",
              "enabled": true
            }
          ],
          "end": [
            {
              "id": "quickActions",
              "enabled": true,
              "options": {
                "actions": [
                  "screenshot",
                  "layoutPicker",
                  "settings"
                ]
              }
            },
            {
              "id": "statusIcons",
              "enabled": true
            },
            {
              "id": "battery",
              "enabled": true
            },
            {
              "id": "tray",
              "enabled": true
            },
            {
              "id": "extensions",
              "enabled": true
            }
          ]
        },
        "reserve": true,
        "thickness": 34,
        "density": "values",
        "backdrop": "solid"
      }
    ],
    "sizes": {
      "innerWidth": 26,
      "contentScale": 1.05
    },
    "status": {
      "showNetwork": true,
      "showBattery": false,
      "showAudio": true
    },
    "scrollActions": {
      "workspaces": true,
      "volume": true,
      "brightness": true
    }
  },
  "border": {
    "frameEnabled": false
  },
  "appearance": {
    "rounding": {
      "scale": 1.2
    },
    "padding": {
      "scale": 1.1
    },
    "spacing": {
      "scale": 1.1
    }
  }
}
