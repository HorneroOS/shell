      {
        "edge": "bottom",
        "style": "attached",
        "reserve": true,
        "margin": 0,
        "thickness": 28,
        "density": "values",
        "backdrop": "solid",
        "groups": {
          "start": [
            {
              "id": "workspaces",
              "enabled": true,
              "options": {}
