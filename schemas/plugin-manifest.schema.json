                      ]
                    }
                  ]
                }
              },
              {
                "properties": {
                  "type": {
                    "const": "number"
                  },
                  "default": {
                    "type": "number"
                  }
                },
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "minLength"
                      ]
                    },
                    {
                      "required": [
                        "maxLength"
                      ]
                    },
                    {
